  "cut_polygons": {
    "type": "object",
    "properties": {
      "polygons": {
        "type": "array",
        "description": "Closed polygons as [[ [x,y], [x,y], ... ], ...] in `units`. Do not repeat the first point; the loop is closed for you. Polygons must not overlap each other -- that is checked before anything is built.",
        "items": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3
        }
      },
      "units": {
        "type": "string",
        "description": "Coordinate units: in, mm, cm, m. Default in.",
        "enum": [
          "in",
          "mm",
          "cm",
          "m"
        ]
      },
      "depth": {
        "type": "string",
        "description": "Cut depth as a unit expression, e.g. '0.5 in'."
      },
      "through": {
        "type": "boolean",
        "description": "Cut clean through the body; default false."
      },
      "plane": {
        "type": "string",
        "description": "Where to sketch: 'top' (default), 'bottom', 'xy', or 'z=<number>'."
      },
      "body": {
        "type": "string",
        "description": "Target body name; defaults to the first body."
      },
      "name": {
        "type": "string",
        "description": "Optional feature name."
      }
    },
    "required": [
      "polygons"
    ],
    "additionalProperties": false
  },
  "extrude_polygons": {
    "type": "object",
    "properties": {
      "polygons": {
        "type": "array",
        "description": "Closed polygons as [[ [x,y], [x,y], ... ], ...] in `units`. Do not repeat the first point; the loop is closed for you. Polygons must not overlap each other -- that is checked before anything is built.",
        "items": {
          "type": "array",
          "items": {
            "type": "array",
