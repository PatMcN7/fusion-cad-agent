          },
          "normal_axis": {
            "type": "string",
            "description": "Unsigned normal axis, e.g. 'z'."
          },
          "axis_along": {
            "type": "string",
            "description": "Cylinder axis, e.g. 'x'."
          },
          "radius": {
            "type": "number",
            "description": "Cylinder radius in cm."
          },
          "extreme": {
            "type": "string",
            "description": "Outermost in a direction, e.g. '-x'."
          }
        }
      },
      "to_face": {
        "type": "object",
        "description": "Which face to mate. Same vocabulary as cuts.",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "planar",
              "cylindrical",
              "any"
            ],
            "description": "Face type. Default planar."
          },
          "body": {
            "type": "string",
            "description": "Body name, if the component has several."
          },
          "facing": {
            "type": "string",
            "description": "Signed outward normal, e.g. '+z'."
          },
          "normal_axis": {
            "type": "string",
            "description": "Unsigned normal axis, e.g. 'z'."
          },
          "axis_along": {
            "type": "string",
            "description": "Cylinder axis, e.g. 'x'."
          },
          "radius": {
            "type": "number",
            "description": "Cylinder radius in cm."
          },
          "extreme": {
            "type": "string",
            "description": "Outermost in a direction, e.g. '-x'."
          }
        }
      },
      "motion": {
        "type": "string",
        "description": "rigid, revolute, slider, cylindrical, planar or ball. Default rigid.",
        "enum": [
          "rigid",
          "revolute",
          "slider",
          "cylindrical",
          "planar",
          "ball"
        ]
      },
      "axis": {
        "type": "string",
        "description": "Motion axis for non-rigid joints: x, y or z. Default z.",
        "enum": [
