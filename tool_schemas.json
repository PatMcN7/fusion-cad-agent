  "lattice_pockets": {
    "type": "object",
    "properties": {
      "pattern": {
        "type": "string",
        "description": "isogrid | hex. Default isogrid.",
        "enum": [
          "isogrid",
          "hex"
        ]
      },
      "cell_size": {
        "type": "string",
        "description": "default '1 in'"
      },
      "rib_width": {
        "type": "string",
        "description": "default '0.1 in'"
      },
      "margin": {
        "type": "string",
        "description": "Solid band at the edges; defaults to rib_width."
      },
      "skin_thickness": {
        "type": "string",
        "description": "Uncut floor; '0 in' cuts through. Default '0 in'."
      },
      "row_stagger": {
        "type": "number",
        "description": "isogrid only: fraction of a cell each row shifts sideways. Default 0.5, which is what makes the field tessellate (six triangles per vertex). 0 gives independent rows separated by horizontal rib bands."
      },
      "row_pitch": {
        "type": "number",
        "description": "isogrid only: multiplier on row spacing. Default 1."
      },
      "include_inverted": {
        "type": "boolean",
        "description": "isogrid only: include inverted triangles. Default true."
      },
      "rotation_degrees": {
        "type": "number",
        "description": "Rotate the field. Default 0."
      },
      "body": {
        "type": "string",
        "description": "Target body name; defaults to the first body."
      },
      "result_name": {
        "type": "string",
        "description": "Optional new name for the pocketed target body."
      },
      "cutter_diameter": {
        "type": "string",
        "description": "Round pocket corners for this router/end-mill, e.g. '0.125 in'. Omit for sharp corners."
      },
      "corner_segments": {
        "type": "integer",
        "description": "Chord segments per rounded corner. Default 6.",
        "minimum": 2,
        "maximum": 64
      },
      "corner_mode": {
        "type": "string",
        "enum": [
          "sharp",
          "sketch_rounding",
          "feature_fillet"
        ],
        "description": "Native sketch representation: feature_fillet keeps triangle lines and adds a separate fillet feature."
      }
    },
    "required": [],
    "additionalProperties": false
  },
